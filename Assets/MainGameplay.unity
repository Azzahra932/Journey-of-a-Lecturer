  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c6de8e8dfea2b2d4ebf3ea410a872d55, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialogueBox: {fileID: 1060699547}
  dialogueBoxImage: {fileID: 1060699549}
  dialogueText: {fileID: 1569748335}
  dialogueLines:
  - sentence: Selamat datang di kampus, Dosen Muda! Selamat atas posisi baru Anda
      sebagai Tenaga Pengajar. Sudah siap mengabdi di dunia akademik?
    customBoxSprite: {fileID: 21300000, guid: 53bc4a47284307e42a6f0862fea0d94b, type: 3}
  - sentence: 'Terima kasih, Bu Kaprodi. Saya siap! Apa tugas pertama yang perlu
      saya selesaikan?

'
    customBoxSprite: {fileID: 21300000, guid: c6510fe780f8e5a4ba46104bc167f13e, type: 3}
  - sentence: '"Fokus awal Anda adalah membangun fondasi Tri Dharma. Mulailah dari
      persiapan mengajar, membimbing mahasiswa, dan melirik riset dasar. Ingat, energi
      dan waktu harian Anda terbatas!'
    customBoxSprite: {fileID: 21300000, guid: 53bc4a47284307e42a6f0862fea0d94b, type: 3}
  - sentence: Sekarang, susun rencana perkuliahan Anda di meja kerja sebelum masuk
      kelas. Selamat bekerja!
    customBoxSprite: {fileID: 21300000, guid: 53bc4a47284307e42a6f0862fea0d94b, type: 3}
  kaprodiCutscene: {fileID: 677828738}
